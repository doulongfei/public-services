# 由宿主机 Caddy 导入，应用端口仅监听本机回环。
tools.lfdou.ccwu.cc, tools.doufei.eu.org {
    encode zstd gzip
    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options nosniff
        X-Frame-Options SAMEORIGIN
        Referrer-Policy strict-origin-when-cross-origin
    }
    reverse_proxy 127.0.0.1:18101
}

pdf.lfdou.ccwu.cc, pdf.doufei.eu.org {
    encode zstd gzip
    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options nosniff
        X-Frame-Options SAMEORIGIN
        Referrer-Policy strict-origin-when-cross-origin
    }
    reverse_proxy 127.0.0.1:18102
}

tr.lfdou.ccwu.cc, tr.doufei.eu.org {
    encode zstd gzip
    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options nosniff
        X-Frame-Options SAMEORIGIN
        Referrer-Policy strict-origin-when-cross-origin
    }
    request_body {
        max_size 64KB
    }
    reverse_proxy 127.0.0.1:18103 {
        # DNS 直连部署：覆盖客户端提供的转发头，限额按真实来源地址计算。
        header_up X-Forwarded-For {remote_host}
        transport http {
            response_header_timeout 120s
        }
    }
}

ai.doufei.eu.org {
    encode zstd gzip
    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options nosniff
        X-Frame-Options SAMEORIGIN
        Referrer-Policy strict-origin-when-cross-origin
    }
    request_body {
        max_size 2MB
    }
    @internal path /metrics /slots /slots/* /lora-adapters /lora-adapters/* /tools /tools/*
    respond @internal 404
    reverse_proxy 127.0.0.1:18104 {
        flush_interval -1
        transport http {
            dial_timeout 10s
            response_header_timeout 600s
        }
    }
}

game.doufei.eu.org {
    encode zstd gzip
    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
        Cache-Control no-cache
        Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'none'; object-src 'none'; frame-src 'none'; frame-ancestors 'none'; form-action 'none'; base-uri 'self'"
    }
    handle /releases/* {
        @asset path_regexp game_asset ^/releases/[0-9]{5}-[a-f0-9]{12}(-v2)?/game/([a-z0-9][a-z0-9_.-]{0,48}\.(js|css|html|json))?$
        handle @asset {
            root * /srv/game-agent/public
            header Cache-Control "public, max-age=604800, immutable"
            file_server
        }
        respond 404
    }
    @entry path / /index.html
    handle @entry {
        root * /srv/game-agent/public/current/game
        file_server
    }
    handle {
        respond 404
    }
}

lab.doufei.eu.org {
    encode zstd gzip
    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy same-origin
        Cache-Control no-cache
        Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; connect-src 'self'; object-src 'none'; frame-src 'none'; frame-ancestors 'none'; form-action 'none'; base-uri 'none'"
    }
    request_body {
        max_size 8KB
    }
    handle /api/* {
        reverse_proxy 127.0.0.1:18106
    }
    handle /desktop.png {
        root * /srv/game-agent/public/current
        file_server
    }
    handle /mobile.png {
        root * /srv/game-agent/public/current
        file_server
    }
    handle {
        root * /opt/starharbor-agent/web
        file_server
    }
}
