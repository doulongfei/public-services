[Unit]
Description=Publish verified subscription and rules to Cloudflare
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /opt/subscription-edge/publisher.py
User=root
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/subscription-edge
CapabilityBoundingSet=
MemoryMax=256M
MemorySwapMax=0
CPUQuota=50%
Nice=10
TimeoutStartSec=600
